# ============================================================
# BPI-R4 标准版 (MT7988A / 4GB RAM / 32GB eMMC)
# 种子配置文件 —— make defconfig 后会自动补全依赖
#
# 修改本文件后重新触发 Actions 即可生成新固件
# ============================================================

# ------------------------------------------------------------ 
# 目标设备：Banana Pi BPI-R4
# ------------------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4=y

# rootfs 分区大小 (MB)
# BPI-R4 eMMC 32GB，放大到 512MB 给 Passwall 全家桶留足空间
CONFIG_TARGET_ROOTFS_PARTSIZE=512

# ------------------------------------------------------------
# LuCI 管理界面（中文）
# ------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# Argon 主题（ImmortalWrt luci 源自带，默认关闭；想要美化可取消注释）
# CONFIG_PACKAGE_luci-theme-argon=y

# ------------------------------------------------------------
# 科学上网 —— Passwall (默认方案)
# 内核: Xray (VLESS/Reality/XTLS) + sing-box + Hysteria
# 注意: INCLUDE 选项名以 2026 版 passwall (v26.9+) 实际符号为准
# ------------------------------------------------------------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# ------------------------------------------------------------
# 科学上网 —— SSR-Plus (备用方案)
# 原 fw866/helloworld 源已下线，如需启用请先在 diy-part1.sh
# 中配置可用的 helloworld 镜像源，再取消下面的注释
# ------------------------------------------------------------
# CONFIG_PACKAGE_luci-app-ssr-plus=y
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
# CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y

# ------------------------------------------------------------
# 自定义 LuCI 应用（由 diy-part1.sh 在编译前 git clone 注入）
# 对应仓库清单见 scripts/diy-part1.sh 第二节
# ------------------------------------------------------------
CONFIG_PACKAGE_luci-app-honk=y          # Honk 微博客（后端 honk 由依赖自动带入）
CONFIG_PACKAGE_luci-i18n-honk-zh-cn=y
CONFIG_PACKAGE_luci-app-oxidns=y       # OxiDNS DNS 分流
CONFIG_PACKAGE_luci-i18n-oxidns-zh-cn=y
CONFIG_PACKAGE_luci-app-netmonitor=y   # 网络质量监控（ICMP 延迟/丢包/连通性）
CONFIG_PACKAGE_luci-i18n-netmonitor-zh-cn=y
CONFIG_PACKAGE_luci-app-trafficctl=y   # 流量控制（限速/整形/断网/WiFi MAC 过滤）
CONFIG_PACKAGE_luci-app-adguardhome=y  # AdGuard Home 去广告（核心包由依赖自动带入）
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y
CONFIG_PACKAGE_luci-app-hw-dashboard=y # 硬件信息仪表盘（温度/频率/NAND ECC 等）

# ------------------------------------------------------------
# 第二批自定义包（由 diy-part1.sh 第三节 git clone 注入）
# ------------------------------------------------------------

# QoS / 流量管理
CONFIG_PACKAGE_qosmate=y
CONFIG_PACKAGE_luci-app-qosmate=y

# 网络工具
CONFIG_PACKAGE_jq=y                     # cloudflare-ip 依赖
CONFIG_PACKAGE_tar=y                    # cloudflare-ip 依赖
CONFIG_PACKAGE_ca-certificates=y        # cloudflare-ip 依赖（curl https 拉取优选 IP 需要）
CONFIG_PACKAGE_xz-utils=y               # tar 的 PACKAGE_TAR_XZ（默认y）可见性前置条件，缺它 tar/cloudflare-ip 会被 defconfig 静默丢弃
CONFIG_PACKAGE_openlist2=y
CONFIG_PACKAGE_luci-app-openlist2=y
CONFIG_PACKAGE_alwaysonline=y
CONFIG_PACKAGE_luci-app-alwaysonline=y
CONFIG_PACKAGE_rgmac=y
CONFIG_PACKAGE_luci-app-change-mac=y

# 系统监控
CONFIG_PACKAGE_luci-app-cpu-status=y
CONFIG_PACKAGE_luci-app-internet-detector=y
CONFIG_PACKAGE_internet-detector=y
CONFIG_PACKAGE_luci-app-log-viewer=y
CONFIG_PACKAGE_luci-app-temp-status=y
CONFIG_PACKAGE_watchdog=y
CONFIG_PACKAGE_luci-app-watchdog=y

# 磁盘 / 风扇 / 硬件管理
CONFIG_PACKAGE_luci-app-mini-diskmanager=y
CONFIG_PACKAGE_luci-app-fancontrol=y

# 组网 / 代理
CONFIG_PACKAGE_easytier=y
# easytier-noweb 与 easytier 互斥变体（同文件 /usr/bin/easytier-cli、easytier-core），
# 二选一：保留完整版 easytier；同时选中会导致 rootfs 组装 apk 冲突失败
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_mihomo=y
CONFIG_PACKAGE_luci-app-fchomo=y
CONFIG_PACKAGE_luci-app-cloudflarespeedtest=y
CONFIG_PACKAGE_luci-app-cloudflare-ip=y

# 网络唤醒
CONFIG_PACKAGE_luci-app-owq-wol=y

# LuCI 主题（10 款）
CONFIG_PACKAGE_luci-theme-graphite=y
CONFIG_PACKAGE_luci-app-graphite=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-theme-liquid=y
CONFIG_PACKAGE_luci-theme-shadcn=y
CONFIG_PACKAGE_luci-theme-footstrap=y
CONFIG_PACKAGE_luci-theme-fluent=y
CONFIG_PACKAGE_luci-mod-fluentdashboard=y
CONFIG_PACKAGE_Obsidian-Theme=y

# ------------------------------------------------------------
# Node.js 运行时（sbwml 预编译版，替换 packages feeds 官方源码编译版）
# 由 diy-part1.sh git clone 注入；构建时下载预编译二进制，编译耗时近乎为零
# ------------------------------------------------------------
CONFIG_PACKAGE_node=y
CONFIG_PACKAGE_node-npm=y

# ------------------------------------------------------------
# 常用系统工具
# ------------------------------------------------------------
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_iperf3=y

# ------------------------------------------------------------
# 以下为编译系统行为控制，一般无需改动
# ------------------------------------------------------------
# 固件文件名包含版本号
CONFIG_VERSION_FILENAMES=y
# 关闭 initramfs recovery 镜像（必须保持关闭！）
# 原因: BPI-R4 的 sdcard.img 布局中 recovery 区仅 12M~44M，
#       本固件包多导致 recovery 镜像 ~69MB 塞不下，构建直接失败；
#       sysupgrade / eMMC / SNAND / sdcard 产物不受影响
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
