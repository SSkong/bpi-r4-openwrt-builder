# ============================================================
# BPI-R4 标准版 (MT7988A / 4GB RAM / 32GB eMMC)
# 种子配置文件 —— make defconfig 后自动补全依赖项
#
# 修改本文件后重新触发 Actions 即可生成新固件
# ============================================================

# ============================================================
# 一、目标平台与存储
# ============================================================

## 目标平台
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4=y

## rootfs 分区大小 (MB)：eMMC 32GB，放大到 960MB
CONFIG_TARGET_ROOTFS_PARTSIZE=960

# ============================================================
# 二、LuCI 管理界面（中文）
# ============================================================

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_LUCI_LANG_zh_Hans=y
# CONFIG_LUCI_CSSTIDY is not set
# CONFIG_LUCI_JSMIN is not set

# ============================================================
# 三、科学上网
# ============================================================

## Passwall（默认方案）：内核 Xray (VLESS/Reality/XTLS) + sing-box + Hysteria
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y

## SSR-Plus（备用方案，由 sbwml/openwrt_helloworld 源提供）
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y

# ============================================================
# 四、自定义 LuCI 应用（由 diy-part1.sh 在编译前 git clone 注入）
# 对应仓库清单见 scripts/diy-part1.sh 第二节
# ============================================================

## eBPF 透明代理（dae + honk，运行需内核 BTF，见文末）
CONFIG_PACKAGE_luci-app-honk=y          # Honk 后端 honk 由依赖自动带入
CONFIG_PACKAGE_dae=y
CONFIG_PACKAGE_luci-app-dae=y

## DNS 分流
CONFIG_PACKAGE_luci-app-oxidns=y       # OxiDNS
CONFIG_PACKAGE_mosdns=y                # mosdns v5.3.4
CONFIG_PACKAGE_geo2txt=y
CONFIG_PACKAGE_luci-app-mosdns=y

## 去广告
CONFIG_PACKAGE_luci-app-adguardhome=y  # 核心二进制运行时从 GitHub 下载，编译时零成本

## 网络监控
CONFIG_PACKAGE_luci-app-netmonitor=y   # 网络质量（ICMP 延迟/丢包/连通性）
CONFIG_PACKAGE_luci-app-cpu-status=y   # CPU 状态（频率/温度/占用）
CONFIG_PACKAGE_luci-app-internet-detector=y # 外网连通性检测
CONFIG_PACKAGE_internet-detector=y
CONFIG_PACKAGE_luci-app-log-viewer=y   # 系统日志增强
CONFIG_PACKAGE_luci-app-temp-status=y  # 温度监控
CONFIG_PACKAGE_watchdog=y              # 看门狗
CONFIG_PACKAGE_luci-app-watchdog=y

## QoS / 流量控制
CONFIG_PACKAGE_luci-app-trafficctl=y   # 流量控制（限速/整形/断网）
CONFIG_PACKAGE_qosmate=y               # nftables 智能限速
CONFIG_PACKAGE_luci-app-qosmate=y

## 带宽监控 / 应用过滤
CONFIG_PACKAGE_luci-app-bandix=y       # 带宽监控
CONFIG_PACKAGE_bandix=y
CONFIG_PACKAGE_kmod-oaf=y              # OpenAppFilter 应用过滤
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_luci-app-oaf=y

## 组网 / 代理 / CDN
CONFIG_PACKAGE_easytier=y              # 去中心化 Mesh 组网
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_mihomo=y                # Clash Meta 内核
CONFIG_PACKAGE_luci-app-fchomo=y
CONFIG_PACKAGE_luci-app-cloudflarespeedtest=y # CDN 优选测速
CONFIG_PACKAGE_luci-app-cloudflare-ip=y       # 优选 IP 自动更新
# —— cloudflare-ip 依赖链（缺 xz-utils 会导致 tar/cloudflare-ip 被 defconfig 静默丢弃）
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_xz-utils=y

## 网络工具
CONFIG_PACKAGE_openlist2=y             # OpenList 多网盘挂载
CONFIG_PACKAGE_luci-app-openlist2=y
CONFIG_PACKAGE_alwaysonline=y          # PPPoE 拨号保活
CONFIG_PACKAGE_luci-app-alwaysonline=y
CONFIG_PACKAGE_rgmac=y                 # MAC 地址查看/修改
CONFIG_PACKAGE_luci-app-change-mac=y
CONFIG_PACKAGE_natmapt=y               # NAT 映射 / STUN 打洞
CONFIG_PACKAGE_stuntman-client=y
CONFIG_PACKAGE_luci-app-natmapt=y
CONFIG_PACKAGE_luci-app-owq-wol=y      # WOL 网络唤醒
CONFIG_PACKAGE_luci-i18n-owq-wol-zh-cn=y
CONFIG_PACKAGE_luci-app-ap-modem=y     # AP/Modem 快捷访问

## 系统工具
CONFIG_PACKAGE_luci-app-hw-dashboard=y # 硬件信息仪表盘（温度/频率/NAND ECC）
CONFIG_PACKAGE_luci-app-mini-diskmanager=y # 磁盘管理
CONFIG_PACKAGE_luci-app-fancontrol=y   # 风扇转速控制
CONFIG_PACKAGE_luci-app-timecontrol=y  # 时间控制
CONFIG_PACKAGE_luci-app-partexp=y      # 分区扩展
CONFIG_PACKAGE_luci-app-taskplan=y     # 任务计划
CONFIG_PACKAGE_luci-app-harbor-file-pro=y # 文件管理
CONFIG_PACKAGE_airconnect=y            # AirPlay 音频转发
CONFIG_PACKAGE_luci-app-airconnect=y

## LuCI 主题（7 款 + 配置器/仪表盘组件）
CONFIG_PACKAGE_luci-theme-graphite=y
CONFIG_PACKAGE_luci-app-graphite=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-theme-liquid=y
CONFIG_PACKAGE_luci-theme-shadcn=y
CONFIG_PACKAGE_luci-theme-footstrap=y  # 替换 luci feeds 自带同名包
CONFIG_PACKAGE_luci-theme-fluent=y
CONFIG_PACKAGE_luci-mod-fluentdashboard=y
CONFIG_PACKAGE_Obsidian-Theme=y
CONFIG_PACKAGE_luci-theme-argon=y      # 源码自带美化主题
CONFIG_PACKAGE_luci-app-argon-config=y

## Node.js 运行时（sbwml 预编译版，替换 packages feeds 官方源码编译版）
## 由 diy-part1.sh git clone 注入；构建时下载预编译二进制，编译耗时近乎为零
CONFIG_PACKAGE_node=y
CONFIG_PACKAGE_node-npm=y

# ============================================================
# 五、常用系统工具
# ============================================================

CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_bash-completion=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_iperf3=y

# ============================================================
# 六、feeds 内置扩展包（非 git clone，直接从 feeds 启用）
# ============================================================

## 网络加速 / 端口映射 / DDNS
CONFIG_PACKAGE_luci-app-turboacc-mtk=y # MTK 平台网络加速（与 luci-app-turboacc 互斥）
CONFIG_PACKAGE_luci-app-upnp=y         # UPnP 自动端口映射
CONFIG_PACKAGE_luci-app-ddns=y          # 动态域名解析
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_ddns-scripts-freedns=y
CONFIG_PACKAGE_ddns-scripts-godaddy=y
CONFIG_PACKAGE_ddns-scripts-services=y

## 网络增强 / 系统工具
CONFIG_PACKAGE_bind-host=y               # BIND DNS 工具（host/dig/nslookup）
CONFIG_PACKAGE_luci-app-arpbind=y        # ARP 绑定防欺骗
CONFIG_PACKAGE_luci-app-ttyd=y           # Web 终端
CONFIG_PACKAGE_luci-app-homeproxy=y      # sing-box 内核 LuCI（与 Passwall 互补）
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-app-momo=y
CONFIG_PACKAGE_luci-app-diskman=y        # 磁盘管理（分区/格式化/SMART/RAID）
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-app-vlmcsd=y         # KMS 激活服务器
CONFIG_PACKAGE_luci-app-watchcat=y       # 网络看门狗
CONFIG_PACKAGE_luci-app-zerotier=y       # ZeroTier 虚拟局域网

## 面板 / DNS 增强
CONFIG_PACKAGE_luci-app-openclash=y      # Clash 图形面板（依赖 ruby 编译较重）
CONFIG_PACKAGE_luci-app-unblockneteasemusic=y # 解锁网易云（依赖 node + dnsmasq-full）
CONFIG_PACKAGE_luci-app-3cat=y           # 3proxy 代理管理
CONFIG_PACKAGE_smartdns=y                # DNS 分流加速
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-app-smartdns_INCLUDE_WebUI=y
CONFIG_PACKAGE_smartdns-ui=y

# ============================================================
# 七、网络 / 存储功能（手动开启）
# ============================================================

## L2TP VPN
CONFIG_PACKAGE_kmod-l2tp=y
CONFIG_PACKAGE_kmod-pppol2tp=y
CONFIG_PACKAGE_ppp-mod-pppol2tp=y
CONFIG_PACKAGE_xl2tpd=y

## Share Network（USB 共享网络）
CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y

# ============================================================
# 八、内核模块（多为依赖自动补全）
# ============================================================

## 网络内核模块
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-tls=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-veth=y

## 加密 / 文件系统
CONFIG_PACKAGE_kmod-crypto-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-xfs=y

## 硬件 / USB / 语言编码
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_kmod-ikconfig=y
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-nls-cp950=y
CONFIG_PACKAGE_kmod-usb-audio=y
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb2-pci=y
CONFIG_PACKAGE_kmod-usb3=y

## 内核模块 —— 第三方驱动
CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor=y # out-of-tree USB 网卡驱动
CONFIG_PACKAGE_kmod-mt7921u=y                  # USB WiFi 适配器

# ============================================================
# 九、工具类与编译相关设置（依赖 defconfig 自动补全）
# ============================================================

## 通用工具
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_file=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_ftp=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_lrzsz=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_lscpu=y
CONFIG_PACKAGE_lsof=y
# CONFIG_PACKAGE_nethogs is not set
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_rename=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_sed=y
CONFIG_PACKAGE_sshpass=y
CONFIG_PACKAGE_taskset=y
CONFIG_PACKAGE_telnet-bsd=y
CONFIG_PACKAGE_tree=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_xfs-admin=y
CONFIG_PACKAGE_xfs-fsck=y
CONFIG_PACKAGE_xfs-growfs=y
CONFIG_PACKAGE_xfs-mkfs=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_zip=y
CONFIG_PACKAGE_zoneinfo-asia=y

## GNU Core Utilities
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-cat=y
CONFIG_PACKAGE_coreutils-chmod=y
CONFIG_PACKAGE_coreutils-chown=y
CONFIG_PACKAGE_coreutils-chroot=y
CONFIG_PACKAGE_coreutils-cp=y
CONFIG_PACKAGE_coreutils-date=y
CONFIG_PACKAGE_coreutils-dd=y
CONFIG_PACKAGE_coreutils-dircolors=y
CONFIG_PACKAGE_coreutils-ls=y
CONFIG_PACKAGE_coreutils-mkdir=y
CONFIG_PACKAGE_coreutils-mv=y
CONFIG_PACKAGE_coreutils-nproc=y
CONFIG_PACKAGE_coreutils-rm=y
CONFIG_PACKAGE_coreutils-sleep=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_coreutils-truncate=y

## procps-ng
CONFIG_PACKAGE_procps-ng=y
CONFIG_PACKAGE_procps-ng-free=y
CONFIG_PACKAGE_procps-ng-ps=y
CONFIG_PACKAGE_procps-ng-top=y

## OpenSSL / ZLIB 构建选项
CONFIG_OPENSSL_ENGINE=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_OPENSSL_WITH_ASM=y
CONFIG_PACKAGE_libopenssl-afalg=y
CONFIG_PACKAGE_libopenssl-conf=y
CONFIG_PACKAGE_libopenssl-devcrypto=y
CONFIG_PACKAGE_libopenssl-legacy=y
CONFIG_PACKAGE_openssl-util=y
# CONFIG_PACKAGE_libopenssl-padlock is not set
# CONFIG_OPENSSL_WITH_ERROR_MESSAGES is not set
CONFIG_ZLIB_OPTIMIZE_SPEED=y

# ============================================================
# 十、编译系统行为控制（一般无需改动）
# ============================================================

## 版本相关
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_FILENAMES=y

## 关闭 initramfs recovery 镜像（必须保持关闭！）
# BPI-R4 的 sdcard.img 布局中 recovery 区仅 12M~44M，本固件包多导致
# recovery 镜像 ~69MB 塞不下，构建直接失败；sysupgrade / eMMC / SNAND / sdcard 产物不受影响
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# ============================================================
# 十一、内核 BTF 支持（dae / honk 等 eBPF 程序运行时必需）
# ============================================================

CONFIG_DEVEL=y
CONFIG_BPF_TOOLCHAIN_HOST=y
# CONFIG_BPF_TOOLCHAIN_NONE is not set
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

# ============================================================
# 十二、Docker 容器（sbwml fork 替换 feeds 官方版，由 diy-part2.sh 替换）
# ============================================================

CONFIG_DOCKER_CGROUP_OPTIONS=y
CONFIG_DOCKER_NET_ENCRYPT=y
CONFIG_DOCKER_NET_MACVLAN=y
CONFIG_DOCKER_NET_OVERLAY=y
CONFIG_DOCKER_NET_TFTP=y
CONFIG_DOCKER_OPTIONAL_FEATURES=y
CONFIG_DOCKER_STO_BTRFS=y
CONFIG_DOCKER_STO_EXT4=y
CONFIG_PACKAGE_luci-app-dockerman=y